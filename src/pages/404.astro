---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cn } from 'cn';
import { buttonVariants } from '@/components/ui/button';
---

<BaseLayout title="Not found" noindex>
  <main class="mx-auto flex min-h-dvh max-w-xl flex-col justify-center gap-6 px-6">
    <h1 class="text-[clamp(2.75rem,5.5vw,7.5rem)] leading-[0.9] font-bold tracking-tighter">
      Cut.
    </h1>
    <p class="text-muted-foreground">That page isn't in this picture.</p>
    <a
      href="/"
      class={cn(buttonVariants({ variant: 'link' }), 'self-start px-0 focus-visible:ring-ring')}
    >
      Back to the start
    </a>
  </main>
</BaseLayout>
