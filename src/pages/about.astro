---
/**
 * Biography. The long-form, factual page: the one search engines send
 * "who is" queries to and the one LLMs are most likely to quote.
 */
import { render } from 'astro:content';
import Prose from '@/components/Prose.astro';
import SplitLayout from '@/layouts/SplitLayout.astro';
import { credits, site } from '@/data/site';
import { getBio } from '@/lib/content';

const bio = await getBio();
const { Content: Bio } = await render(bio);
const frontmatter = bio.data;

const listed = [...(bio.body ?? '').matchAll(/^- _(.+?)_(?: \([^)]*\))?(?:, (.+))?$/gm)].map(
  (m) => ({ title: m[1], character: m[2]?.trim() }),
);
const show = (list: { title: string; character?: string }[]) =>
  list.map((c) => (c.character ? `${c.title} (${c.character})` : c.title)).join(', ');
if (
  listed.length !== credits.length ||
  credits.some((c, i) => listed[i].title !== c.title || listed[i].character !== c.character)
) {
  throw new Error(
    `Credits in about.md (${show(listed)}) don't match src/data/site.ts (${show(credits)}).`,
  );
}
---

<SplitLayout
  title={frontmatter.title}
  description={frontmatter.description}
  shareDescription={frontmatter.shareDescription}
  kind="profile"
  markdown="/about.md"
  created={frontmatter.created.toISOString()}
  modified={frontmatter.updated.toISOString()}
>
  <header class="flex flex-col gap-[clamp(1.5rem,2.5vw,3rem)] pt-12 md:pt-[var(--gutter)]">
    <a
      href="/"
      class="self-start text-lg font-bold tracking-tight transition-colors hover:text-primary"
    >
      {site.name}
    </a>
    <h1 class="text-[clamp(2.75rem,5.5vw,7.5rem)] leading-[0.9] font-bold tracking-tighter">
      {frontmatter.heading}
    </h1>
  </header>

  <main class="py-[clamp(2.5rem,5vw,6rem)]">
    <Prose
      variant="long"
      class="max-w-[60ch] text-[clamp(1.0625rem,1.2vw,1.375rem)] leading-relaxed"
    >
      <Bio />
    </Prose>
  </main>
</SplitLayout>
