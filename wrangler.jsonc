{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "austinfalk-com",
  // The account comes from CLOUDFLARE_ACCOUNT_ID: a gitignored .env locally,
  // a build variable in Workers Builds. Kept out of the repo on purpose.
  "compatibility_date": "2026-09-07",
  // Static-only site: no Worker script, Cloudflare serves ./dist directly.
  // `astro build` writes _redirects and _headers into dist for Cloudflare to honor.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Fallback only: Cloudflare's own slash handling redirects with a 307.
    // The permanent 301s live in public/_redirects and run first.
    "html_handling": "drop-trailing-slash",
  },
  // Required by `wrangler preview` (Worker Previews), which Workers Builds runs
  // for every non-main branch. Empty: previews share the settings above.
  "previews": {},
  // The site lives at austinfalk.com. Cloudflare creates the DNS record and the
  // certificate; no other record may exist at the apex. www → apex is a
  // Cloudflare redirect rule, not a route here.
  "routes": [{ "pattern": "austinfalk.com", "custom_domain": true }],
  // No workers.dev address for the live site. Both settings are explicit:
  // dashboard toggles are undone by the next deploy, and since Wrangler 4.44
  // preview URLs follow workers_dev unless set, which would turn off the
  // Preview URLs on pull requests.
  "workers_dev": false,
  "preview_urls": true,
}
